# R (do not commit machine-local environment state)
.Rhistory
.RData
.Ruserdata
.Rproj.user

# renv — commit renv.lock but NOT the local library cache
renv/library/
renv/staging/
renv/local/
renv/python/

# Render output — the book is built from source, so ignore generated HTML
/docs/
/book/
*_files/
_rsessions/

# Python (if you add Python chapters)
__pycache__/
*.pyc
.venv/

# Editor / OS
.DS_Store

_book/

/.quarto/
**/*.quarto_ipynb
